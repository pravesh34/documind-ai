# ---------------------------------------------------------------------------
# DocuMind AI — environment template
# Copy to `.env` (project root or backend/) and edit. Every value below is
# optional: with an empty file the whole stack runs offline with zero keys.
# ---------------------------------------------------------------------------

# --- Application -----------------------------------------------------------
ENVIRONMENT=development            # development | test | production
DEBUG=false
LOG_LEVEL=INFO
PORT=8000
ENABLE_DOCS=true
# The backend resolves relative paths against the project root.
FRONTEND_DIST=dist
# CSV or JSON array. Use explicit origins in production.
CORS_ORIGINS=http://localhost:5173,http://localhost:8000
# CSV or JSON array. Set to your real hostnames in production.
TRUSTED_HOSTS=*

# --- Persistence -----------------------------------------------------------
# Leave empty for the in-memory dev repository. REQUIRED in production.
# DATABASE_URL=postgresql://documind:documind@localhost:5432/documind
DATABASE_URL=
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
AUTO_CREATE_SCHEMA=true
SEED_DEFAULT_DOCUMENTS=true
EMBEDDING_DIMENSIONS=768

# --- Redis / Celery --------------------------------------------------------
REDIS_URL=
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=
BACKGROUND_ENRICHMENT=true

# --- Security --------------------------------------------------------------
# none | api-key. Defaults to none in development and api-key in production.
# AUTH_MODE=none
# Format: `key:tenant,key2:tenant2`. Required when AUTH_MODE=api-key.
API_KEYS=
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT=300/minute
RATE_LIMIT_CHAT=30/minute
MAX_UPLOAD_BYTES=26214400
MAX_TEXT_CHARS=5000000
METRICS_ENABLED=true

# --- Free / local AI providers --------------------------------------------
# auto | ollama | gemini | groq | openrouter | none
LLM_PROVIDER=auto
# auto | ollama | gemini | huggingface | deterministic
EMBEDDING_PROVIDER=auto

# Local Ollama (unlimited, no key)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=llama3.2:3b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Google AI Studio free tier — https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_CHAT_MODEL=gemini-2.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Groq free tier — https://console.groq.com/keys
GROQ_API_KEY=
GROQ_CHAT_MODEL=openai/gpt-oss-120b

# OpenRouter free models — https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_CHAT_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Hugging Face Inference — https://huggingface.co/settings/tokens
HF_API_TOKEN=
HF_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

AI_TIMEOUT_SECONDS=30
AI_MAX_RETRIES=2

# --- RAG / LangGraph -------------------------------------------------------
CHUNK_SIZE=1200
CHUNK_OVERLAP=200
RRF_K=60
RETRIEVAL_TOP_K=6
RETRIEVAL_CANDIDATES=24
SIMILARITY_THRESHOLD=0.28
MAX_RETRIEVAL_ATTEMPTS=2
MAX_REVISION_ATTEMPTS=1
GROUNDING_THRESHOLD=0.55
MULTI_QUERY_ENABLED=true
LLM_GRADING_ENABLED=false
GRAPH_EXPANSION_ENABLED=true
GRAPH_SEED_CHUNKS=6
GRAPH_NEIGHBOR_ENTITIES=16
GRAPH_NEIGHBOR_CHUNKS=8
ENTITY_EXTRACTION_MODE=heuristic
ENTITY_EXTRACTION_LIMIT=12

# --- Evaluation ------------------------------------------------------------
EVAL_MAX_TESTS=50
EVAL_CONCURRENCY=2
